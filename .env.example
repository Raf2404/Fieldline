# Base de données
# - En local : `npm run db:up` (Docker) et garde cette valeur, ou mets l'URL d'un projet Supabase de test.
# - En production : URL du pooler Supabase (Project Settings > Database > Connection string > Transaction).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crampons

# Secret de signature des sessions admin (32 caractères aléatoires minimum).
# Génère-en un avec : openssl rand -base64 32
SESSION_SECRET=change-moi-avec-une-longue-valeur-aleatoire

# Stockage des photos
# - Vide : les photos sont rangées dans .data/uploads (local uniquement).
# - Production : Supabase Storage (bucket public « products »).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# URL publique du site (liens dans les e-mails, référencement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret du nettoyage automatique des commandes non payées (/api/cron/commandes-expirees).
# Vercel l'envoie tout seul à sa tâche planifiée. Génère-le avec : openssl rand -base64 32
CRON_SECRET=

# E-mails (https://resend.com, gratuit jusqu'à 3 000 e-mails/mois)
# Sans clé, les e-mails ne partent pas mais restent visibles dans la fiche commande de l'admin (utile en local).
RESEND_API_KEY=
# Expéditeur : une adresse de ton nom de domaine, vérifié dans Resend.
EMAIL_FROM=Fieldline <commandes@ton-domaine.fr>
# Adresse qui reçoit les réponses des clients (facultatif).
EMAIL_REPLY_TO=
